// Project tasks configuration. See https://zed.dev/docs/tasks for documentation.
//
// Example:
[
  {
    "label": "LazyGit",
    "command": "lazygit",
    "shell": {
      "program": "sh"
    },
    "hide": "on_success",
    "reveal_target": "center",
    "show_summary": false,
    "show_command": false,
    "allow_concurrent_runs": true,
    "use_new_terminal": true
  },
  {
    "label": "Open Code",
    "command": "opencode",
    "hide": "on_success",
    "reveal_target": "center",
    "env": {
      "EDITOR": "zeditor",
      "VISUAL": "zeditor"
    },
    "show_summary": false,
    "show_command": false,
    "allow_concurrent_runs": true,
    "use_new_terminal": true
  },
  {
    "label": "Rojo Serve",
    "command": "rojo serve"
  },
  {
    "label": "Rojo Autogenerate sourcemap",
    "command": "rojo sourcemap --watch --include-non-scripts --output sourcemap.json"
  }
]
